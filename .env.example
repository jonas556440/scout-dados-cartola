# ScoutDados Environment Template
# Copie para .env e preencha os valores reais
# NUNCA commite o .env real!

# Environment: development | production
ENV=production
DEBUG=False

# Security - gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# CORS - origens permitidas (separar por vírgula)
ALLOWED_ORIGINS=https://scoutdados.com.br,https://www.scoutdados.com.br

# Database
DATABASE_URL=sqlite:///data/cartola.db

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/api.log

# APIs Externas (opcional)
# APIFOOTBALL_KEY=your-api-key-here

# Chaves de acesso administrativo - gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_API_KEY=your-admin-key-here
# BLOG_API_KEY=your-blog-key-here

# Google Analytics (opcional)
# GA_MEASUREMENT_ID=G-XXXXXXXXXX
