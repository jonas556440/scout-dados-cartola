# Cartola FC 2026 - Frontend Environment Variables (Template)
# Copie este arquivo para .env e ajuste conforme necessário

# API URL
# - Desenvolvimento: deixe vazio (Vite proxy /api -> localhost:8000)
# - Produção: deixe vazio (Apache/Nginx faz proxy reverso)
# - API externa: VITE_API_URL=https://api.scoutdados.com.br
VITE_API_URL=

# Ambiente (development | production)
VITE_ENV=development

# Analytics (opcional)
VITE_GA_ID=
VITE_SENTRY_DSN=
